# Copy this file to backend/.env and replace the placeholders.
# Azure OpenAI v1 Responses API endpoint. The endpoint and API key must belong
# to the same Foundry/OpenAI resource; a gateway subscription key is not interchangeable.
GEN_AI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/responses
# Use the deployment name, which may differ from the underlying model name.
GEN_AI_MODEL=YOUR_MODEL_DEPLOYMENT_NAME
GEN_AI_API_KEY=YOUR_MATCHING_RESOURCE_API_KEY

# Direct Microsoft Foundry model endpoints use the api-key header without a prefix.
GEN_AI_API_KEY_HEADER=api-key
GEN_AI_API_KEY_PREFIX=

# Optional request timeout in milliseconds.
GEN_AI_TIMEOUT_MS=30000
