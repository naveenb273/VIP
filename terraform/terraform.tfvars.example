# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

# Short identifier for your hackspace (alphanumeric, hyphens OK, no spaces)
app_name = "aetsample"

# Database admin username
db_username = "pgadmin"

# Microfoft Provider authentication secret
microsoft_provider_auth_secret = "MICROSOFT_PROVIDER_AUTHENTICATION_SECRET"

# Shared App Service Plan
shared_app_service_plan_id = "/subscriptions/445b0818-90bc-4af0-911a-c61f511c7693/resourceGroups/rg-shared-resources/providers/Microsoft.Web/serverFarms/apwedsodev-hackspaces-shared" 